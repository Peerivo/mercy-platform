FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

WORKDIR /app
ENV NODE_ENV=test

RUN addgroup -S app \
  && adduser -S app -G app \
  && chown app:app /app

COPY --chown=app:app package*.json ./
USER app
RUN npm ci

COPY --chown=app:app . .

CMD ["./node_modules/.bin/vitest", "run", "tests/happy-food-rescue.staging-e2e.test.ts"]
