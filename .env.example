# Embedded at build time; provide before `next build`.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Legacy fallback only: NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Server-only feedback email delivery through Resend.
# Feedback is still saved in Supabase when email delivery is not configured.
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL="Язык милосердия <feedback@example.com>"
FEEDBACK_TO_EMAIL=owner@example.com
# Optional dedicated recipient for new-request review notifications.
# Falls back to FEEDBACK_TO_EMAIL when omitted.
REQUEST_REVIEW_TO_EMAIL=owner@example.com

# CI/deployment only; never expose with NEXT_PUBLIC_:
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# SUPABASE_PROJECT_ID=
