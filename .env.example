# Embedded at build time; provide before `next build`.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Legacy fallback only: NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Public canonical site URL used for auth callbacks and redirects.
NEXT_PUBLIC_SITE_URL=https://mercy.peerivo.net

# Peerivo ID client configuration.
# Values are names/placeholders only. Real values must come from the canonical Peerivo secrets store.
PEERIVO_AUTH_ENABLED=1
PEERIVO_AUTH_URL=https://auth.peerivo.net
PEERIVO_AUTH_CLIENT_ID=mercy
PEERIVO_AUTH_REDIRECT_URI=https://mercy.peerivo.net/auth/callback

# Server-only bridge secrets.
# These are required to convert a verified Peerivo identity into a local Mercy Supabase session.
# Never expose with NEXT_PUBLIC_. Do not commit real values.
SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy alias if a deployment already uses this name:
# MERCY_SUPABASE_SERVICE_ROLE_KEY=
PEERIVO_AUTH_LOCAL_PASSWORD_SECRET=

# Optional override for the public CloudTips donation page URL.
# Must be HTTPS on cloudtips.ru or a subdomain. Mercy has a verified public default.
NEXT_PUBLIC_DONATION_URL=

# Server-only feedback email delivery through Resend.
# Feedback is still saved in Supabase when email delivery is not configured.
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL="Язык милосердия <feedback@example.com>"
FEEDBACK_TO_EMAIL=owner@example.com

# CI/deployment only; never expose with NEXT_PUBLIC_:
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# SUPABASE_PROJECT_ID=
